  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set(\"today\", new Date().toISOString().slice(0, 10));",
          "pm.collectionVariables.set(\"runSuffix\", Date.now().toString());",
          "pm.sendRequest({ url: pm.collectionVariables.get(\"baseUrl\") + \"/api/csrf-token\", method: \"GET\" }, function (error, response) {",
          "    if (!error && response.code === 200) {",
          "        const tokenData = response.json();",
          "        pm.collectionVariables.set(\"csrfHeaderName\", tokenData.headerName);",
          "        pm.collectionVariables.set(\"csrfToken\", tokenData.token);",
          "        pm.request.headers.upsert({ key: tokenData.headerName, value: tokenData.token });",
          "    }",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Аутентификация и CSRF",
      "description": "Сначала получите CSRF-токен и зарегистрируйте пользователя. После регистрации выполните в MySQL Workbench: UPDATE users SET role = 'ADMIN' WHERE username = 'admin'; затем используйте authUsername=admin и authPassword=ChangeMe123 для административных запросов. Для обычного пользователя используйте его логин и пароль.",
      "item": [
        {
          "name": "Получить CSRF-токен",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/csrf-token"
            }
          }
        },
        {
          "name": "Зарегистрировать пользователя",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Администратор\",\n  \"username\": \"admin\",\n  \"password\": \"ChangeMe123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register"
            }
          }
        }
      ]
    },
